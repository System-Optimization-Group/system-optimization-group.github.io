---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PaperItem from '../components/PaperItem.astro';
import NewsItem from '../components/NewsItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { papers } from '../lib/papers';
import { useI18n } from '../i18n';
import AreaTile from '../components/AreaTile.astro';
import { getAreas } from '../lib/areas';

const { t, l, s } = useI18n(Astro);
const areas = await getAreas();
const members = await getCollection('members');
const pi = members.filter((m) => m.data.role === 'pi');
const news = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
const projects = (await getCollection('projects')).filter((p) => p.data.active)
  .sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base>
  <div class="layout">
    <section class="about">
      <p class="kicker tag">{s.institution}</p>
      <h1>{s.name}</h1>
      {s.about.map((p) => <p>{p}</p>)}
      {pi.length > 0 && (
        <p class="lead-by">
          {t(pi.length > 1 ? 'home.groupLeaders' : 'home.groupLeader')}{t('ui.colon')}
          {pi.map((m, i) => <><a href={l(`/people/${m.id}`)}>{m.data.name}</a>{i < pi.length - 1 ? ', ' : ''}</>)}
        </p>
      )}
      <p class="cta">
        <a class="btn primary" href={l('/research')}>{t('nav.research')}</a>
        <a class="btn" href={l('/publications')}>{t('nav.publications')}</a>
        <a class="btn" href={l('/people')}>{t('nav.people')}</a>
      </p>
    </section>

    <aside class="side">
      <section>
        <div class="section-head"><h2>{t('home.news')}</h2><a href={l('/news')}>{t('ui.all')}</a></div>
        {news.map((n) => <NewsItem item={n} brief />)}
      </section>
      <section class="join-band" aria-labelledby="join-h">
        <div class="jb-text">
          <h2 id="join-h">{t('home.join')}</h2>
          <p>{t('home.joinText')}</p>
        </div>
        <a class="jb-btn" href={l('/join')}>{t('home.joinLink')}</a>
      </section>
    </aside>
  </div>

  <section class="section">
    <div class="section-head"><h2>{t('home.areas')}</h2><a href={l('/research')}>{t('ui.all')}</a></div>
    <ol class="area-list">{areas.map((a, i) => <li><AreaTile area={a} index={i} /></li>)}</ol>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>{t('home.projects')}</h2><a href={l('/research')}>{t('home.allProjects')}</a></div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}

  <section class="section">
    <div class="section-head"><h2>{t('home.recentPubs')}</h2><a href={l('/publications')}>{t('home.allPubs')}</a></div>
    <div>{papers.slice(0, 5).map((p) => <PaperItem paper={p} compact />)}</div>
  </section>
</Base>

<style>
  .layout { display: grid; gap: 48px; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; gap: 24px; } }
  .about h1 { margin-bottom: 18px; font-size: clamp(2rem, 4.6vw, 2.9rem); line-height: 1.15; }
  .about p { font-size: 1.08rem; }
  .lead-by { font-style: italic; }
  .about .kicker { margin: 0 0 10px; font-size: 0.78rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 0; }
  .side { display: flex; flex-direction: column; gap: 32px; }
  .side h2 { font-size: 1.15rem; }
  .side .section-head { margin-bottom: 4px; }

  /* "Join our group!" card under News: navy panel with faint rings. */
  .join-band {
    --ink: var(--on-accent);
    --line: rgb(255 255 255 / 0.22);
    --line: color-mix(in srgb, var(--on-accent) 22%, transparent);
    position: relative; overflow: hidden; isolation: isolate;
    padding: 26px 24px 24px; border-radius: 6px;
    background: var(--accent); color: var(--ink);
  }
  .join-band::before {          /* decorative concentric rings, top-right */
    content: ''; position: absolute; z-index: -1; width: 320px; height: 320px; right: -130px; top: -150px;
    background: repeating-radial-gradient(circle, transparent 0 26px, var(--line) 26px 27px);
    mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 70%);
  }
  .jb-text h2 { font-size: 1.45rem; margin-bottom: 8px; color: var(--ink); }
  .jb-text p { font-size: 0.98rem; line-height: 1.6; opacity: 0.88; margin-bottom: 18px; }
  .jb-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 999px;
    background: var(--ink); color: var(--accent); font: 600 0.9rem var(--sans);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .jb-btn:hover { text-decoration: none; transform: translateY(-1px); box-shadow: 0 6px 18px rgb(0 0 0 / 0.25); }
</style>
